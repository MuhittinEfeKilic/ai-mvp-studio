MVP_STUDIO_HOST=127.0.0.1
MVP_STUDIO_PORT=8000
# Aynı anda yürütülebilecek proje sayısı
MVP_STUDIO_MAX_CONCURRENT_RUNS=3
# Tüm projeler boyunca aynı anda çalışabilecek Codex süreci sayısı
MVP_STUDIO_MAX_CONCURRENT_AGENTS=5
# Tek proje içinde paralel çalışabilecek Flutter Builder görevi sayısı
MVP_STUDIO_MAX_PARALLEL_BUILDERS=4
# Tek bir Codex çağrısının üst süre sınırı (ms)
MVP_STUDIO_CODEX_TIMEOUT_MS=3600000
# Tek bir Flutter/Gradle komutunun üst süre sınırı (ms)
MVP_STUDIO_FLUTTER_TIMEOUT_MS=600000
# Kesintisiz bir çalışmanın harcayabileceği faturalanabilir token (0 = sınırsız)
MVP_STUDIO_PROJECT_TOKEN_BUDGET=1500000
MVP_STUDIO_CODEX_COMMAND=codex
FLUTTER_BIN=C:\flutter\bin\flutter.bat
ADB_BIN=C:\Users\USERNAME\AppData\Local\Android\Sdk\platform-tools\adb.exe
# Cihaz testi başlamadan önce AVD /data bölümünde gereken boş alan (MB)
MVP_STUDIO_DEVICE_MIN_FREE_MB=1536
# Cihaz bu değerin altına düşerse sıfırlanır; üstündeyse hiçbir şey yapılmaz.
MVP_STUDIO_DEVICE_RECLAIM_BELOW_MB=3072
# Cihaz kapısının açmasına, sıfırlamasına ve wipe etmesine izin verilen AVD.
# Boş bırakılırsa listedeki ilk emülatör kullanılır — birden fazla AVD varsa
# bu, kişisel cihazınızın sıfırlanması anlamına gelebilir.
MVP_STUDIO_AVD=studio_test_api36
# Rol bazlı model ve reasoning effort: role=model veya role=model:effort, virgülle.
#
# VARSAYILAN OLARAK BOŞ BIRAKIN. Maliyet için ucuz modele geçmek 26 Eylül 2026'da
# gerçek bir koşuda denendi ve hattı böldü: koşu 1.038.597 token harcadı ve
# çalışan uygulama üretmedi. Kısaca: repair hatayı teşhis etmek için kurulu
# Flutter sürümünün gerçek API'sini bilmek zorunda ve ucuz model orada tahmin
# ediyor. Yetenek dursun, varsayılan kullanım olmasın.
# Ayrıntı ve sayılar: docs/LESSONS.md → 1, docs/TODO.md "Ucuz model denemesi".
#
# Doğru ayrım "mekanik / yargı" DEĞİL, "bilgi gerektiren / gerektirmeyen".
# Kod yazan ya da kod okuyup karar veren hiçbir rolü küçültmeyin. Maliyet
# düşürmek isterseniz hedef koşu sayısı olmalı, model kalitesi değil.
# Atanmayan rol dokunulmaz ve ~/.codex/config.toml ne diyorsa onu kullanır.
# Geçerli roller: architecture, ux, data_model, test_strategy, coordinator,
# flutter_builder, integration, repair, device_repair, review_repair, reviewer
#
# Aşağıdaki satır yalnız SÖZDİZİMİ örneğidir, öneri değildir:
# MVP_STUDIO_AGENT_MODELS=integration=gpt-5.6-luna:low
